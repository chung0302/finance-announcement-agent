# 复制本文件为 .env 后填写真实值（.env 不会被提交，也不会被写入任何日志或产物）
# 说明：不配置任何变量时，应用依然可以启动，会自动进入「演示模式」。

# OpenAI 兼容接口地址（末尾不要带 /chat/completions）
LLM_BASE_URL=https://api.openai.com/v1

# 模型 API 密钥：留空则应用自动降级为演示模式
LLM_API_KEY=

# 模型名称
LLM_MODEL=gpt-4o-mini

# 可选：单次请求超时秒数，默认 60
# LLM_TIMEOUT=60

# 可选：失败重试次数，默认 2
# LLM_MAX_RETRIES=2

# 可选：送入模型的公告文本最大字符数，默认 12000
# MAX_INPUT_CHARS=12000
